.env
*.env*
node_modules/
evals/results/*.json
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/COPYRIGHT.md
.DS_Store
*.key
*.pem

# Internal session/audit artifacts (not for public repo)
analytics/

# Render-parity baseline snapshots (scripts/render-parity-check.sh)
tmp/

# Build outputs
ae101-content.tar.gz
agents-101-starter.tar.gz
!site/clients/**/*.tar.gz

# Internal-only customer staging — built locally for the gated (ai-training-internal)
# deploy, must NEVER be committed to this public repo. Excluding the directory also
# overrides the tar.gz re-include above (git can't re-include a file under an
# excluded parent), so `git add -A` can't leak gated content.
site/clients/goats/
# Northwind: the publishing side builds from its own agents-102 clone and publishes
# on Northwind's Git, so nothing built here is ever committed or served. Build
# command recorded on the registry entry in site/layouts/curriculum.js.
site/clients/northwind/
# Personalised VIP builds (`build-workbook.js … --theory --for "<Name>"`). The
# rendered HTML carries a real prospect name, which must never reach this repo.
# Wildcard so a new recipient needs no .gitignore edit — the build asks git
# whether the target dir is ignored and refuses to write if it isn't.
site/clients/vip-*/

# Superpowers tooling scratch (brainstorm tokens, sdd run artifacts)
.superpowers/

# Deploy-time copy of content/ (pages.yml rebuilds it on every deploy).
site/content

# Firing tracker log (scripts/fire-log.sh) — one machine, one session history.
.fire-log

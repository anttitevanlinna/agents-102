{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${AGENTS_CORE_DIR:-$CLAUDE_PROJECT_DIR/../agents-102-core}\"/project-claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${AGENTS_CORE_DIR:-$CLAUDE_PROJECT_DIR/../agents-102-core}\"/project-claude/hooks/surface-detector.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${AGENTS_CORE_DIR:-$CLAUDE_PROJECT_DIR/../agents-102-core}\"/project-claude/hooks/prompt-edit-gate.sh"
          },
          {
            "type": "command",
            "command": "\"${AGENTS_CORE_DIR:-$CLAUDE_PROJECT_DIR/../agents-102-core}\"/project-claude/hooks/built-artifact-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${AGENTS_CORE_DIR:-$CLAUDE_PROJECT_DIR/../agents-102-core}\"/project-claude/hooks/post-write-reminder.sh"
          },
          {
            "type": "command",
            "command": "\"${AGENTS_CORE_DIR:-$CLAUDE_PROJECT_DIR/../agents-102-core}\"/project-claude/hooks/banned-phrase-grep.sh"
          },
          {
            "type": "command",
            "command": "\"${AGENTS_CORE_DIR:-$CLAUDE_PROJECT_DIR/../agents-102-core}\"/project-claude/hooks/eval-class-router.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${AGENTS_CORE_DIR:-$CLAUDE_PROJECT_DIR/../agents-102-core}\"/project-claude/hooks/stop-compound-nudge.sh"
          },
          {
            "type": "command",
            "command": "\"${AGENTS_CORE_DIR:-$CLAUDE_PROJECT_DIR/../agents-102-core}\"/project-claude/hooks/core-autocommit.sh"
          }
        ]
      }
    ]
  }
}

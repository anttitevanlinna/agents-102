#!/usr/bin/env bash
set -euo pipefail

case_name="${FAKE_CODEX_CASE:-success-start}"
printf '%s\n' "$*" >> "${FAKE_CODEX_LOG:?FAKE_CODEX_LOG is required}"
if [[ -n "${FAKE_CODEX_PWD_LOG:-}" ]]; then
  pwd >> "$FAKE_CODEX_PWD_LOG"
fi

started() {
  local thread_id="${1:-thread-123}"
  printf '%s\n' \
    "{\"type\":\"thread.started\",\"thread_id\":\"$thread_id\"}" \
    '{"type":"turn.started"}'
}

completed() {
  local text="${1:-done}"
  printf '%s\n' \
    "{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"$text\"}}" \
    '{"type":"turn.completed","usage":{"input_tokens":11,"output_tokens":7}}'
}

case "$case_name" in
  success-start)
    started
    completed 'first response'
    ;;
  success-resume)
    started
    completed 'second response'
    ;;
  turn-failed)
    started
    printf '%s\n' \
      '{"type":"item.completed","item":{"type":"agent_message","text":"looks final"}}' \
      '{"type":"turn.failed","error":{"message":"synthetic failure"}}'
    ;;
  malformed)
    started
    printf '%s\n' 'not-json'
    ;;
  missing-thread)
    printf '%s\n' '{"type":"turn.started"}'
    completed 'orphan response'
    ;;
  changed-thread)
    started 'thread-999'
    completed 'wrong thread'
    ;;
  exit-seven)
    started
    printf '%s\n' '{"type":"item.completed","item":{"type":"agent_message","text":"partial"}}'
    exit 7
    ;;
  timeout)
    exec sleep 30
    ;;
  isolated-home)
    [[ -f "$CODEX_HOME/auth.json" ]]
    [[ "$(find "$CODEX_HOME" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')" == 1 ]]
    [[ "$(stat -f '%Lp' "$CODEX_HOME")" == 700 ]]
    [[ "$(stat -f '%Lp' "$CODEX_HOME/auth.json")" == 600 ]]
    mkdir -p "$CODEX_HOME/sessions/2026/09/03"
    printf '%s\n' '{"type":"response_item","payload":{"type":"function_call","namespace":"collaboration","name":"spawn_agent"}}' > "$CODEX_HOME/sessions/2026/09/03/parent.jsonl"
    started
    completed 'isolated'
    ;;
  *)
    echo "unknown fake case: $case_name" >&2
    exit 64
    ;;
esac

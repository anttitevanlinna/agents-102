RUN arrange-lemmings --sut <SB>/sut --slug fix-hud-tally
RUN run-prework --cwd <SB>/sut scenario=prework.txt
RUN run-m1 --cwd <SB>/sut --task-slug fix-hud-tally scenario=m1.txt
GIT checkout -B m2/add-levels-2-3 m1endsha
RUN run-m2 --cwd <SB>/sut --task-slug add-levels-2-3 scenario=m2.txt
GIT checkout -B m4/blocker-deadlock-terminal m2endsha
RUN run-m4 --cwd <SB>/sut --task-slug blocker-deadlock-terminal scenario=m4.txt
GIT branch -f m4/agent-slug spsha
GIT worktree remove --force <SB>/home/Projects/lemmings-m5
GIT branch -D m5/agent-slug
GIT worktree prune
RUN run-m5 --main-cwd <SB>/sut --worktree-cwd <SB>/home/Projects/lemmings-m5 scenario=m5.txt
WIPE pre-wipe task.md
WIPE pre-wipe plan.md
EXIT 0

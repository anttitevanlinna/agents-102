# Full-cut resume at M4 with an explicit --m3-sha: position there, run M4..M6.
GIT checkout -B m4/blocker-deadlock-terminal m3override
RUN run-m4 --cwd <SB>/sut --task-slug blocker-deadlock-terminal scenario=m4.txt
GIT branch -f m4/agent-slug spsha
GIT worktree remove --force <SB>/home/Projects/lemmings-m5
GIT branch -D m5/agent-slug
GIT worktree prune
RUN run-m5 --main-cwd <SB>/sut --worktree-cwd <SB>/home/Projects/lemmings-m5 scenario=m5.txt
RUN run-m6 --cwd <SB>/home/Projects/lemmings-m5 --task-slug blocker-deadlock-terminal scenario=m6.txt
WIPE pre-wipe task.md
WIPE pre-wipe plan.md
WIPE pre-wipe ~/.claude/skills/session-shaper-lemmings
EXIT 0
